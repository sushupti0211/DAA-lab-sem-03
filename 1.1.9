#include <stdio.h>
#define MAX 50

int adj[MAX][MAX], visited[MAX], queue[MAX];
int front = 0, rear = -1;

void bfs(int start, int n) {
    visited[start] = 1;
    queue[++rear] = start;

    while (front <= rear) {
        int u = queue[front++];
        printf("%d ", u);
        for (int v = 0; v < n; v++)
            if (adj[u][v] && !visited[v]) {
                visited[v] = 1;
                queue[++rear] = v;
            }
    }
    printf("\n");
}

int main() {
    int n, start;
    printf("Enter number of vertices: ");
    scanf("%d", &n);
    printf("Enter adjacency matrix:\n");
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            scanf("%d", &adj[i][j]);
    printf("Enter starting vertex (0 to %d): ", n - 1);
    scanf("%d", &start);

    printf("BFS traversal: ");
    bfs(start, n);
    return 0;
}
